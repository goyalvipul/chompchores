.env
.env.*
!.env.example
!**/.env.example
apps/web-pwa/config.js
apps/web-pwa/config.local.js
**/credentials.json
**/serviceAccount*.json
*.pem
*.key
!*.example.key

# Dependencies & build output
node_modules/
dist/
build/
coverage/
.turbo/
.next/
.cache/

# Expo / mobile
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.mobileprovision

# Snapshots / imports (may contain household data)
exports/**
