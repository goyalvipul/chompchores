# Supabase CLI local state
supabase/.branches
supabase/.temp

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Logs
*.log
npm-debug.log*
